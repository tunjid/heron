{
  "lexicon": 1,
  "id": "social.heron.calendar.getRsvpedEvents",
  "defs": {
    "main": {
      "type": "query",
      "description": "List events the authenticated viewer has RSVPed to, most recent RSVP first. Requires authentication.",
      "parameters": {
        "type": "params",
        "properties": {
          "status": {
            "type": "string",
            "knownValues": [
              "community.lexicon.calendar.rsvp#going",
              "community.lexicon.calendar.rsvp#interested",
              "community.lexicon.calendar.rsvp#notgoing"
            ],
            "description": "Only events the viewer responded to with this status. Bare tokens (going) are accepted."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": {
            "type": "string"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["events"],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "events": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "social.heron.calendar.defs#eventView"
              }
            }
          }
        }
      },
      "errors": [
        {
          "name": "AuthRequired",
          "description": "Authentication is required for this endpoint."
        }
      ]
    }
  }
}
