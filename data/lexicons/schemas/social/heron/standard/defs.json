{
  "lexicon": 1,
  "id": "social.heron.standard.defs",
  "defs": {
    "publicationView": {
      "type": "object",
      "required": ["uri", "cid", "author", "record", "sortedAt"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri"
        },
        "cid": {
          "type": "string",
          "format": "cid"
        },
        "author": {
          "type": "ref",
          "ref": "social.heron.actor.defs#profileView"
        },
        "record": {
          "type": "unknown",
          "description": "The full site.standard.publication record."
        },
        "iconUrl": {
          "type": "string",
          "format": "uri",
          "description": "Resolved PDS URL for the publication icon blob."
        },
        "sortedAt": {
          "type": "string",
          "format": "datetime",
          "description": "Canonical sort timestamp. Derived from TID in record key, or publishedAt for documents."
        },
        "viewerSubscription": {
          "type": "ref",
          "ref": "#subscriptionView",
          "description": "The authenticated viewer's subscription record for this publication. Absent if not subscribed or unauthenticated."
        }
      }
    },
    "subscriptionView": {
      "type": "object",
      "required": ["uri", "cid", "publicationUri", "sortedAt"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri"
        },
        "cid": {
          "type": "string",
          "format": "cid"
        },
        "publicationUri": {
          "type": "string",
          "format": "at-uri",
          "description": "AT URI of the publication this subscription targets."
        },
        "sortedAt": {
          "type": "string",
          "format": "datetime",
          "description": "Canonical sort timestamp for the subscription (derived from the record TID)."
        }
      }
    },
    "documentView": {
      "type": "object",
      "required": ["uri", "cid", "author", "record", "recommendationCount"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri"
        },
        "cid": {
          "type": "string",
          "format": "cid"
        },
        "author": {
          "type": "ref",
          "ref": "social.heron.actor.defs#profileView"
        },
        "record": {
          "type": "unknown",
          "description": "The full site.standard.document record."
        },
        "coverImageUrl": {
          "type": "string",
          "format": "uri",
          "description": "Resolved PDS URL for the document cover image blob."
        },
        "publication": {
          "type": "ref",
          "ref": "#publicationView"
        },
        "recommendationCount": {
          "type": "integer",
          "minimum": 0,
          "description": "How many people recommend this document. Each person counts once, however many site.standard.graph.recommend records they wrote for it."
        },
        "viewerRecommendation": {
          "type": "ref",
          "ref": "#recommendationView",
          "description": "The authenticated viewer's site.standard.graph.recommend record for this document. Absent if not recommended or unauthenticated."
        }
      }
    },
    "recommendationView": {
      "type": "object",
      "required": ["uri", "cid", "documentUri", "sortedAt"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri"
        },
        "cid": {
          "type": "string",
          "format": "cid"
        },
        "documentUri": {
          "type": "string",
          "format": "at-uri",
          "description": "AT URI of the recommended document."
        },
        "sortedAt": {
          "type": "string",
          "format": "datetime",
          "description": "Canonical sort timestamp for the recommendation (its createdAt, else the record TID)."
        }
      }
    }
  }
}
